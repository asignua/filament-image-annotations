{
    "name": "asignua/filament-image-annotations",
    "description": "Non-destructive vector annotations for Filament: arrows, rectangles, ellipses, lines, a pen, a highlighter and text drawn over an image as a separate JSON layer. The original file is never modified.",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "image",
        "annotations",
        "markup",
        "media-library"
    ],
    "homepage": "https://github.com/asignua/filament-image-annotations",
    "support": {
        "issues": "https://github.com/asignua/filament-image-annotations/issues",
        "source": "https://github.com/asignua/filament-image-annotations"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mykhailo Hladchenko",
            "email": "myhailo@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0",
        "spatie/laravel-medialibrary": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Asignua\\FilamentImageAnnotations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asignua\\FilamentImageAnnotations\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asignua\\FilamentImageAnnotations\\ImageAnnotationsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "filament/spatie-laravel-media-library-plugin": "Annotate images stored through Spatie Media Library.",
        "spatie/laravel-medialibrary": "Annotate Spatie Media items; their annotations are removed together with the media."
    }
}
