includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    ignoreErrors:
        # Shipped for the host's models; the package itself never uses it.
        -
            identifier: trait.unused
            path: src/Concerns/HasImageAnnotations.php
